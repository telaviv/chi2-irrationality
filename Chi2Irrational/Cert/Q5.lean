/-
# The dual certificate for q = 5: kernel checks

Every check of `CData.Valid` for `DataQ5.data` by `decide +kernel`; the certified exponent
`Φ ≤ PhiQ < −2.385`. Theorem B then gives `|Δ_h(χ₂(1/5))| ≤ exp((Φ + ε) h²)` eventually.
Data generated by `scripts/gen_cert.py 5 40 2 23 2 2` (untrusted; every number is re-checked by the kernel).
-/
import Chi2Irrational.Cert.DataQ5

namespace Chi2Irr.Cert.Q5

open Chi2Irr.Cert CData

lemma tabOK : checkTab data.tab 1 = true := by decide +kernel

lemma cells0 : data.cellsOK 0 40 = true := by decide +kernel

lemma cells1 : data.cellsOK 40 40 = true := by decide +kernel

lemma EOK : data.EOK = true := by decide +kernel

lemma tailOK : data.tailOK = true := by decide +kernel

theorem valid : data.Valid where
  q2 := by decide
  L1 := by decide
  X1 := by decide
  NX := by decide
  Ks := by decide
  len := by decide +kernel
  slen := by decide +kernel
  crange := by decide +kernel
  mass := by decide +kernel
  tab := tabOK
  cells := fun k hk => by
    have hk' : k < 80 := hk
    rcases lt_or_ge k 40 with h | h
    · exact data.cells_of 0 40 cells0 k (by omega) (by omega)
    · exact data.cells_of 40 40 cells1 k h (by omega)
  tail := tailOK
  E := EOK

lemma phiQ_le : data.PhiQ ≤ -2385 / 1000 := by decide +kernel

/-- **Theorem B for `q = 5`:** `|Δ_h(χ₂(1/5))| ≤ exp((−2.385 + ε) h²)` eventually. -/
theorem analytic : ∀ ε > 0, ∀ᶠ h : ℕ in Filter.atTop,
    |Polynomial.aeval (chi2 (1 / ((5 : ℕ) : ℝ))) (Delta 5 h)| ≤ Real.exp ((-2385 / 1000 + ε) * (h : ℝ) ^ 2) := by
  intro ε hε
  have hq : 2 ≤ data.q := by decide
  filter_upwards [(toCert valid).analytic hq ε hε] with h hh
  refine hh.trans (Real.exp_le_exp.mpr (mul_le_mul_of_nonneg_right ?_ (sq_nonneg _)))
  have h1 := Phi_le valid
  have h2 : (data.PhiQ : ℝ) ≤ -2385 / 1000 := by exact_mod_cast phiQ_le
  linarith

end Chi2Irr.Cert.Q5
