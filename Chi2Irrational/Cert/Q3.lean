/-
# The dual certificate for q = 3: kernel checks

Every check of `CData.Valid` for `DataQ3.data` by `decide +kernel`; the certified exponent
`Φ ≤ PhiQ < −2.078`. Theorem B then gives `|Δ_h(χ₂(1/3))| ≤ exp((Φ + ε) h²)` eventually.
Data generated by `scripts/gen_cert.py 3 100 5 30 3 2` (untrusted; every number is re-checked by the kernel).
-/
import Chi2Irrational.Cert.DataQ3

namespace Chi2Irr.Cert.Q3

open Chi2Irr.Cert CData

lemma tabOK : checkTab data.tab 1 = true := by decide +kernel

lemma cells0 : data.cellsOK 0 50 = true := by decide +kernel

lemma cells1 : data.cellsOK 50 50 = true := by decide +kernel

lemma cells2 : data.cellsOK 100 50 = true := by decide +kernel

lemma cells3 : data.cellsOK 150 50 = true := by decide +kernel

lemma cells4 : data.cellsOK 200 50 = true := by decide +kernel

lemma cells5 : data.cellsOK 250 50 = true := by decide +kernel

lemma EOK : data.EOK = true := by decide +kernel

lemma tailOK : data.tailOK = true := by decide +kernel

theorem valid : data.Valid where
  q2 := by decide
  L1 := by decide
  X1 := by decide
  NX := by decide
  Ks := by decide
  len := by decide +kernel
  slen := by decide +kernel
  crange := by decide +kernel
  mass := by decide +kernel
  tab := tabOK
  cells := fun k hk => by
    have hk' : k < 300 := hk
    rcases lt_or_ge k 50 with h0 | h0
    · exact data.cells_of 0 50 cells0 k (by omega) (by omega)
    rcases lt_or_ge k 100 with h1 | h1
    · exact data.cells_of 50 50 cells1 k h0 (by omega)
    rcases lt_or_ge k 150 with h2 | h2
    · exact data.cells_of 100 50 cells2 k h1 (by omega)
    rcases lt_or_ge k 200 with h3 | h3
    · exact data.cells_of 150 50 cells3 k h2 (by omega)
    rcases lt_or_ge k 250 with h4 | h4
    · exact data.cells_of 200 50 cells4 k h3 (by omega)
    · exact data.cells_of 250 50 cells5 k h4 (by omega)
  tail := tailOK
  E := EOK

lemma phiQ_le : data.PhiQ ≤ -2078 / 1000 := by decide +kernel

/-- **Theorem B for `q = 3`:** `|Δ_h(χ₂(1/3))| ≤ exp((−2.078 + ε) h²)` eventually. -/
theorem analytic : ∀ ε > 0, ∀ᶠ h : ℕ in Filter.atTop,
    |Polynomial.aeval (chi2 (1 / ((3 : ℕ) : ℝ))) (Delta 3 h)| ≤ Real.exp ((-2078 / 1000 + ε) * (h : ℝ) ^ 2) := by
  intro ε hε
  have hq : 2 ≤ data.q := by decide
  filter_upwards [(toCert valid).analytic hq ε hε] with h hh
  refine hh.trans (Real.exp_le_exp.mpr (mul_le_mul_of_nonneg_right ?_ (sq_nonneg _)))
  have h1 := Phi_le valid
  have h2 : (data.PhiQ : ℝ) ≤ -2078 / 1000 := by exact_mod_cast phiQ_le
  linarith

end Chi2Irr.Cert.Q3
