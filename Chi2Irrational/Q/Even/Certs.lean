/-
# Theorem Q₄: the direct certificates at `q = 6, 8, 10, 12`

`cert_newQ_proof` (stub `cert_newQ` of `Q/Even/Interface.lean`): for `q ∈ newQ` a `DualCert q` with `Φ ≤ PhiT q`.
The certificates are `Cert/Q{6,8,10,12}.lean` (data `Cert/DataQ*.lean`, generated by `scripts/gen_cert.py`; every
check by `decide +kernel`). Certified exponents `PhiQ`: −2.5635463 (q = 6, L = 400), −2.7264892 (8), −2.8528813 (10),
−2.9535971 (12) (L = 200 for q = 8, 10, 12).
-/
import Chi2Irrational.Q.Even.Defs
import Chi2Irrational.Cert.Q6
import Chi2Irrational.Cert.Q8
import Chi2Irrational.Cert.Q10
import Chi2Irrational.Cert.Q12

namespace Chi2Irr
namespace Q

/-- **Direct certificates** at `q = 6, 8, 10, 12`. -/
theorem cert_newQ_proof {q : ℕ} (hq : q ∈ newQ) : ∃ C : DualCert q, C.Phi ≤ (PhiT q : ℝ) := by
  simp only [newQ, Finset.mem_insert, Finset.mem_singleton] at hq
  rcases hq with rfl | rfl | rfl | rfl
  · exact ⟨_, Cert.Q6.phi_le.trans (by norm_num [PhiT])⟩
  · exact ⟨_, Cert.Q8.phi_le.trans (by norm_num [PhiT])⟩
  · exact ⟨_, Cert.Q10.phi_le.trans (by norm_num [PhiT])⟩
  · exact ⟨_, Cert.Q12.phi_le.trans (by norm_num [PhiT])⟩

end Q
end Chi2Irr
