% [1] Hata 1990
% Checked 2026-10-18:
%   zbMATH API record Zbl 0712.11040 (https://zbmath.org/4171026): title, J. Math. Pures Appl. (9)
%     vol. 69, no. 2, pp. 133--173, 1990. No DOI is registered (Crossref search finds none; do not add one).
%   Same title/volume/pages in the bibliography of David--Hirata-Kohno--Kawashima, arXiv:1912.03811, ref. [15].
%   Content (from F. Beukers' zbMATH review; the paper itself was NOT read): the paper treats
%     L(alpha,k;x) = sum_{n>=1} x^n/(n-alpha)^k for rational alpha_1,...,alpha_m in [0,1) and
%     k_j in N, and proves an effective lower bound |n_0 + sum n_j L(alpha_j,k_j;1/q)| >= H^{-xi-eps}
%     for integers |q| > q_0. Stated application: L_2(1/q) irrational for q >= 12 or q <= -8.
%   Use for our claim: with alpha = 1/2, k = 2, x = 1/q^2,
%     L(1/2,2;1/q^2) = sum_{n>=1} q^{-2n}/(n-1/2)^2 = (4/q) chi_2(1/q),
%     so Hata's theorem (applied with q^2 in place of q) gives chi_2(1/q) irrational for all
%     sufficiently large integers q. This is the correct Hata paper for that claim (the 1993 TAMS
%     paper is about Li_2 only). The exact theorem number in the paper was not checked.
@article{Hata1990,
  author   = {Hata, Masayoshi},
  title    = {On the linear independence of the values of polylogarithmic functions},
  journal  = {J. Math. Pures Appl. (9)},
  volume   = {69},
  number   = {2},
  year     = {1990},
  pages    = {133--173},
  note     = {Zbl 0712.11040},
}

